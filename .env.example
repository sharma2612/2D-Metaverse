# ---- API runtime secrets (server-side only, never exposed to the browser) ----
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/2d-metaverse
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY=7d

# Comma-separated list of allowed browser origins. Leave unset for same-origin
# only. Example: https://your-app.onrender.com
CLIENT_ORIGIN=

# Cloudinary (profile/avatar uploads) -- see api/db/cloudinary.js
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LiveKit token minting -- see api/token.js
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Build-time secrets (baked into the JS bundle by Vite; they ship to the
# browser, so only ever put public client config here) ----
VITE_FIREBASE_KEY=
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud