# Hardcoded deploy configuration.
#
# FORMAT: strict KEY=value, no spaces around the equals sign, no inline comments,
# one variable per line. This file is sourced by /bin/sh during `docker build`
# (to inline the VITE_* values into the bundle) and parsed by dotenv at runtime,
# so every line must be valid in both. dotenv tolerates `KEY = value`; the shell
# treats that as a command and fails the build.
#
# WARNING: this file is committed to a public GitHub repository. Rotate Mongo,
# Cloudinary, LiveKit, and any other credential here at the provider, then
# update this file.

# ---- Server runtime ----
PORT=5000
NODE_ENV=production

# Replaces the original JWT_SECRET ("adfasfasdgsgaasdgasdgasdfg"), which is in
# public git history and would let anyone mint a valid session cookie.
JWT_SECRET=8f4c2a91b7e63d05fa1c9e4b27d38a6f0e51c9b3d7a28e64f105b93c7d2e8a4f
JWT_EXPIRY=10d

MONGO_URL="mongodb+srv://anmoldhiman525:anmol123@cluster0.ofqdtte.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"

CLOUDINARY_NAME=dddfnsi50
CLOUDINARY_API_KEY=346158871214966
CLOUDINARY_API_SECRET=-pE2MAWMeyzO0p9iDRDPIl3UNmY

# Same-origin deployment, so the browser always hits this host. Set a
# comma-separated list only when the client is served from a different host
# than the API.
CLIENT_ORIGIN=*

# ---- LiveKit (video rooms) ----
LIVEKIT_URL=wss://videoserve-h5g2fyz6.livekit.cloud
LIVEKIT_API_KEY=APIt2qHS7weggnT
LIVEKIT_API_SECRET=OapKKwogGEfNSj3l8Be68MaZEt8AwvyzHtSup9dcgfwB

# ---- TURN (WebRTC NAT traversal) ----
# Still unset. STUN alone cannot traverse symmetric NAT, which is most mobile
# carrier data, so calls fail to connect for a large share of mobile users.
# Get free credentials at https://www.openrelay.metered.ca and fill these in.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ---- Frontend build-time ----
# The browser needs its own copy of the LiveKit URL. Vite only inlines VITE_*
# variables, so the server-only LIVEKIT_URL above is not visible to client code.
# RoomView.jsx reads this one and passes it to Room.connect().
VITE_LIVEKIT_URL=wss://videoserve-h5g2fyz6.livekit.cloud
# Firebase web API keys are public by design: they ship in the browser bundle and
# are protected by Security Rules rather than by secrecy.
VITE_FIREBASE_KEY=AIzaSyCzb6aTyuOq5FSIuN7CJ-sBIgPvpmHRVic